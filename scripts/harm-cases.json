     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: DRIFT'; exit 1\n"
   },
   "tip": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "expect": {
    "exit": 0,
    "rows": [
     "g1 REPAIRED"
    ],
    "summary": "repaired=1"
   }
  },
