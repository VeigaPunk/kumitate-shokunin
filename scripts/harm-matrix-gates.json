{
 "contract": "kumitate-harm-matrix-v2",
 "note": "Registry of lane gates run by scripts/harm-matrix.mjs at a base and a tip revision (round 65: 36 gates, measured by seat K65ExecHarmRegistry in fresh sandbox clones, build/K65ExecHarmRegistry/registry-v2-table.md). verdict is an anchored regex over output lines with a capture group; capture 1 is the verdict word (a hyphen-extended word such as CLEAN-STALE or FAIL-CLOSED is its own word); a gate is CLEAN only when its exit is in ok_exit (default [0]), the LAST verdict word is in clean and no earlier verdict line carried a non-clean word outside ignore_words. timeout is clamp(ceil(5 x slowest measured run, 10), 45, 120) seconds. scope records whether a gate reads only its sandbox (sandbox-pure) or host state (host-state: the host is the same at both revisions, so such a gate can only ever read CARRIED or CARRIED_MOVED when red). Out of the registry: wave-census bare (usage exit 64, no verdict line).",
 "gates": [
  {"id": "readme-map", "argv": ["node", "scripts/readme-map.mjs"], "verdict": "^README_MAP: (CLEAN|DRIFT|FAIL-CLOSED)\\b", "clean": ["CLEAN"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "proxy-check", "argv": ["node", "scripts/proxy-check.mjs", "--strict"], "verdict": "^PROXY: (\\w+)", "clean": ["MATCH"], "timeout": 45, "scope": "host-state"},
  {"id": "claims-check", "argv": ["node", "scripts/claims-check.mjs"], "verdict": "^CLAIMS: (\\w+)", "clean": ["MATCH"], "timeout": 45, "scope": "host-state"},
