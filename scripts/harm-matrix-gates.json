  {"id": "plan-before-ready-selftest", "argv": ["bash", "scripts/plan-before-ready.sh", "--selftest"], "verdict": "^PLAN_BEFORE_READY_SELFTEST: (\\w+)", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure (latent lane-absolute default: scripts/plan-before-ready.sh:59 REPO_DEFAULT=/home/vgpnk/Projects/shokunin/kumitate-shokunin, unused under --selftest)"},
  {"id": "wave-census-selftest", "argv": ["node", "scripts/wave-census.mjs", "--selftest"], "verdict": "^WAVE_CENSUS_SELFTEST: \\d+/\\d+ (\\w+)", "clean": ["pass"], "timeout": 45, "scope": "sandbox-pure"},
