  {"id": "anchor-truth", "argv": ["node", "scripts/anchor-truth.mjs", "--base", "e18ff1af3392e3823227644c977c237737fe65c9"], "verdict": "^TRUTH: (\\w+)", "clean": ["CLEAN"], "timeout": 45, "scope": "host-state"},
  {"id": "surface-known", "argv": ["node", "scripts/surface-probe.mjs", "--known", ".ufo/pins/surface-known.json"], "verdict": "^SURFACE_PROBE: (\\w+)", "clean": ["CLEAN"], "timeout": 45, "scope": "host-state"},
  {"id": "wave-census-r40", "argv": ["node", "scripts/wave-census.mjs", "--round", "40"], "verdict": "^WAVE_CENSUS: (\\w+)", "clean": ["CLEAN"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "cite-sources-selftest", "argv": ["node", "scripts/cite-sources.mjs", "--selftest"], "verdict": "^CITE_SOURCES_SELFTEST: (\\w+)", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "round-gate-selftest", "argv": ["node", "scripts/round-gate.mjs", "--selftest"], "verdict": "^ROUND_GATE_SELFTEST: \\d+/\\d+ (\\w+)", "clean": ["pass"], "timeout": 120, "scope": "sandbox-pure"},
  {"id": "sources-check-selftest", "argv": ["node", "scripts/sources-check.mjs", "--selftest"], "verdict": "^SOURCES_SELFTEST: \\d+/\\d+ (\\w+)", "clean": ["pass"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "counter-pins-selftest", "argv": ["node", "scripts/counter-pins.mjs", "--selftest"], "verdict": "^COUNTER_PINS_SELFTEST: (\\w+)", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure"},
