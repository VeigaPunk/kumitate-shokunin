  {"id": "source-capture", "argv": ["node", "scripts/source-capture.mjs"], "verdict": "^SOURCE_CAPTURE: (\\w+)", "clean": ["CLEAN"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "source-dupes", "argv": ["node", "scripts/source-dupes.mjs"], "verdict": "^SOURCE_DUPES: (\\w+)", "clean": ["CLEAN"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "kimi-census", "argv": ["node", "scripts/kimi-census.mjs"], "verdict": "^KIMI_CENSUS: (\\w+)", "clean": ["CLEAN"], "timeout": 45, "scope": "host-state"},
