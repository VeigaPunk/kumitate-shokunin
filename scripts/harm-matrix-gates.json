  {"id": "cap-run-selftest", "argv": ["node", "scripts/cap-run.mjs", "--selftest"], "verdict": "^CAP_RUN_SELFTEST: \\d+/\\d+ (\\w+)", "clean": ["pass"], "timeout": 50, "scope": "sandbox-pure"},
  {"id": "receipt-attest-selftest", "argv": ["node", "scripts/receipt-attest.mjs", "--selftest"], "verdict": "^ATTEST_SELFTEST: (\\w+)", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "receipt-evidence-selftest", "argv": ["node", "scripts/receipt-evidence.mjs", "--selftest"], "verdict": "^RECEIPT_EVIDENCE_SELFTEST: (\\w+)", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "dispatch-evidence-selftest", "argv": ["node", "scripts/dispatch-evidence.mjs", "--selftest"], "verdict": "^DISPATCH_EVIDENCE_SELFTEST: (\\w+)", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "inline-dispatch-evidence-selftest", "argv": ["node", "scripts/inline-dispatch-evidence.mjs", "--selftest"], "verdict": "^INLINE_DISPATCH_SELFTEST: (\\w+)", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "claims-check-selftest", "argv": ["node", "scripts/claims-check.mjs", "--selftest"], "verdict": "^CLAIMS_SELFTEST: \\d+/\\d+ (\\w+)", "clean": ["pass"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "proxy-check-selftest", "argv": ["node", "scripts/proxy-check.mjs", "--selftest"], "verdict": "^PROXY_SELFTEST: \\d+/\\d+ (\\w+)", "clean": ["pass"], "timeout": 100, "scope": "sandbox-pure"},
  {"id": "kimi-census-selftest", "argv": ["node", "scripts/kimi-census.mjs", "--selftest"], "verdict": "^KIMI_CENSUS_SELFTEST: \\d+/\\d+ (\\w+)", "clean": ["pass"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "omp-census-selftest", "argv": ["node", "scripts/omp-census.mjs", "--selftest"], "verdict": "^VERDICT: (PASS|FAIL) \\(\\d+ cases\\)", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "bind-oracle", "argv": ["node", "scripts/bind-oracle.mjs"], "verdict": "^BIND_ORACLE: (\\w+)", "clean": ["HELD"], "timeout": 45, "scope": "sandbox-pure (bwrap child; no host path in argv)"},
  {"id": "source-capture-selftest", "argv": ["node", "scripts/source-capture.mjs", "--selftest"], "verdict": "^SOURCE_CAPTURE_SELFTEST: (\\w+)", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure"},
  {"id": "jj-seat-demo", "argv": ["bash", "scripts/jj-seat-demo.sh"], "verdict": "^JJ_SEAT_DEMO: (\\w+)", "clean": ["DONE"], "timeout": 60, "path_extra": ["$HOME/.local/bin"], "scope": "sandbox-pure (HOME/XDG fixture-local; jj from $HOME/.local/bin, appended after /usr/bin:/bin)"},
  {"id": "surface-probe-selftest", "argv": ["node", "scripts/surface-probe.mjs", "--selftest"], "verdict": "^VERDICT: (PASS|FAIL)\\b", "clean": ["PASS"], "timeout": 45, "scope": "sandbox-pure"}
 ]
