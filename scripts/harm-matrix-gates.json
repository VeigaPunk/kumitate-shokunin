  {"id": "cite-check-fleet-dot", "argv": ["node", "scripts/cite-check.mjs", "--fleet", "."], "verdict": "^CITE_CHECK: (\\w+)", "clean": ["CLEAN"], "timeout": 45, "scope": "sandbox-pure (--fleet . pins the fleet parent inside the sandbox; the bare form reads dirname --self, i.e. /tmp, and its verdict changed with that directory: errors=1545 warnings=771 vs errors=1506 warnings=768)"},
