From 1770be61610f7056bc607e337cc4c54f135f2ea2 Mon Sep 17 00:00:00 2001
From: ctl <ctl@ctl>
Date: Fri, 23 Oct 2026 06:59:47 -0300
Subject: [PATCH] CtlDirectSystemd: inline bounded scope and bwrap without
 cap-run

---
 scripts/anchor-truth.mjs  | 15 ++++++++++++++-
 scripts/claims-check.mjs  | 24 +++++++++++++++++-------
 scripts/kimi-census.mjs   | 20 +++++++++++++++-----
 scripts/sources-check.mjs | 32 ++++++++++++++++++++++++++------
 4 files changed, 72 insertions(+), 19 deletions(-)

diff --git a/scripts/anchor-truth.mjs b/scripts/anchor-truth.mjs
index a0747c3..02a91b8 100755
--- a/scripts/anchor-truth.mjs
+++ b/scripts/anchor-truth.mjs
@@ -799,7 +799,20 @@ function selfTest() {
     return d;
   };
   const tool = (self, args) => {
-    const r = spawnSync(process.execPath, [TOOL_FILE, '--self', self, ...args], { encoding: 'utf8', env: gitEnv() });
+    const cwd = process.cwd();
+    const cmd = realpathSync(process.execPath);
+    const setenv = Object.entries({ ...gitEnv(), PATH: `${dirname(cmd)}:/usr/bin` })
+      .filter(([, value]) => value !== undefined).flatMap(([key, value]) => ['--setenv', key, value]);
+    const argv = ['--user', '--scope', '--quiet',
+      '-p', 'MemoryMax=512M', '-p', 'MemorySwapMax=0', '-p', 'TasksMax=64', '--',
+      'env', '-i', 'PATH=/usr/bin', 'bwrap', '--ro-bind', '/', '/', '--dev', '/dev', '--proc', '/proc',
+      '--tmpfs', '/tmp', '--tmpfs', '/run', '--bind', cwd, cwd, '--bind', tmp, tmp, '--chdir', cwd,
+      '--unshare-pid', '--die-with-parent', '--new-session', '--clearenv', ...setenv,
+      '--argv0', process.execPath, cmd, TOOL_FILE, '--self', self, ...args];
+    const r = spawnSync('/usr/bin/systemd-run', argv, {
+      encoding: 'utf8', timeout: 60_000, killSignal: 'SIGKILL',
+      env: { PATH: '/usr/bin', XDG_RUNTIME_DIR: process.env.XDG_RUNTIME_DIR || `/run/user/${process.getuid()}` },
+    });
     const out = r.stdout ?? '';
     return { status: r.status, out, verdict: out.trim().split('\n').pop() ?? '' };
   };
diff --git a/scripts/claims-check.mjs b/scripts/claims-check.mjs
index d5fe701..e313aa5 100755
