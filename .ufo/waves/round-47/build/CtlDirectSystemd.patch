 }
 
-function runClaims(args, env) {
-  const r = spawnSync(process.execPath, [TOOL_FILE, ...args], {
-    encoding: 'utf8', timeout: 60_000, env: gitEnv(env),
-  });
-  return { status: r.status, stdout: r.stdout ?? '', stderr: r.stderr ?? '' };
-}
-
 function verdictLine(run) {
   const lines = run.stdout.trim().split('\n');
   return lines.length > 0 ? lines[lines.length - 1] : '';
@@ -895,6 +888,23 @@ function kinds(run) {
 
 function selfTest() {
   const tmp = mkdtempSync(join(tmpdir(), 'kumitate-claims-selftest-'));
+  function runClaims(args, env) {
+    const cwd = process.cwd();
+    const cmd = realpathSync(process.execPath);
+    const setenv = Object.entries({ ...gitEnv(env), PATH: `${dirname(cmd)}:/usr/bin` })
+      .filter(([, value]) => value !== undefined).flatMap(([key, value]) => ['--setenv', key, value]);
+    const argv = ['--user', '--scope', '--quiet',
+      '-p', 'MemoryMax=512M', '-p', 'MemorySwapMax=0', '-p', 'TasksMax=64', '--',
+      'env', '-i', 'PATH=/usr/bin', 'bwrap', '--ro-bind', '/', '/', '--dev', '/dev', '--proc', '/proc',
+      '--tmpfs', '/tmp', '--tmpfs', '/run', '--bind', cwd, cwd, '--bind', tmp, tmp, '--chdir', cwd,
+      '--unshare-pid', '--die-with-parent', '--new-session', '--clearenv', ...setenv,
+      '--argv0', process.execPath, cmd, TOOL_FILE, ...args];
+    const r = spawnSync('/usr/bin/systemd-run', argv, {
+      encoding: 'utf8', timeout: 60_000, killSignal: 'SIGKILL',
+      env: { PATH: '/usr/bin', XDG_RUNTIME_DIR: process.env.XDG_RUNTIME_DIR || `/run/user/${process.getuid()}` },
+    });
+    return { status: r.status, stdout: r.stdout ?? '', stderr: r.stderr ?? '' };
+  }
   const results = [];
   const observed = new Set();
   const failClosedSeen = new Set();
