+  function runTool(args) {
+    const cwd = process.cwd();
+    const cmd = realpathSync(process.execPath);
+    const argv = ['--user', '--scope', '--quiet',
+      '-p', 'MemoryMax=512M', '-p', 'MemorySwapMax=0', '-p', 'TasksMax=64', '--',
