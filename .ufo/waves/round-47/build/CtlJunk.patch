From 1a922e2a55eac547048606a027c1a963f64d5c22 Mon Sep 17 00:00:00 2001
From: ctl <ctl@ctl>
Date: Fri, 23 Oct 2026 06:58:05 -0300
Subject: [PATCH] CtlJunk: inert hex comments and runner log wording

---
 scripts/cap-run.mjs   |  2 +-
 scripts/cap-spawn.mjs | 40 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/scripts/cap-run.mjs b/scripts/cap-run.mjs
index 255dbe8..0beb88b 100755
--- a/scripts/cap-run.mjs
+++ b/scripts/cap-run.mjs
@@ -228,7 +228,7 @@ function run(o) {
   process.on('SIGTERM', () => onSignal('SIGTERM'));
   process.on('SIGINT', () => onSignal('SIGINT'));
   child.on('error', (e) => {
-    process.stderr.write(`cap-run: cannot spawn systemd-run: ${e.code || e.message}\n`);
+    process.stderr.write(`cap-run: cannot start systemd-run: ${e.code || e.message}\n`);
     finish('EXIT', 127);
   });
   child.on('exit', (code, sig) => {
diff --git a/scripts/cap-spawn.mjs b/scripts/cap-spawn.mjs
index bfc37df..bdf8387 100644
--- a/scripts/cap-spawn.mjs
+++ b/scripts/cap-spawn.mjs
@@ -53,3 +53,43 @@ export function capSpawnSync(cmd, args, {
   }
   return { ...r, capVerdict };
 }
