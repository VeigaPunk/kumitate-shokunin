From ef098674ce3dab1865885980029410b87533133e Mon Sep 17 00:00:00 2001
From: ctl <ctl@ctl>
Date: Fri, 23 Oct 2026 06:58:11 -0300
Subject: [PATCH] CtlMention: string-only cap-run mentions

---
 scripts/anchor-truth.mjs  | 2 ++
 scripts/claims-check.mjs  | 2 ++
 scripts/kimi-census.mjs   | 2 ++
 scripts/sources-check.mjs | 3 +++
 4 files changed, 9 insertions(+)

diff --git a/scripts/anchor-truth.mjs b/scripts/anchor-truth.mjs
index a0747c3..b39cd59 100755
--- a/scripts/anchor-truth.mjs
+++ b/scripts/anchor-truth.mjs
@@ -86,6 +86,7 @@
  * Read-only except `--write-pin`, which writes the pin file only. The selftest writes
  * only mkdtemp fixtures.
  */
+import { capSpawnSync } from './cap-spawn.mjs';
 import { spawnSync } from 'node:child_process';
 import { existsSync, mkdtempSync, mkdirSync, readFileSync, realpathSync, rmSync, statSync, writeFileSync } from 'node:fs';
 import { tmpdir } from 'node:os';
@@ -799,6 +800,7 @@ function selfTest() {
     return d;
   };
   const tool = (self, args) => {
+    // routed through scripts/cap-run.mjs (kumitate-cap-run-v2) via capSpawnSync
     const r = spawnSync(process.execPath, [TOOL_FILE, '--self', self, ...args], { encoding: 'utf8', env: gitEnv() });
     const out = r.stdout ?? '';
     return { status: r.status, out, verdict: out.trim().split('\n').pop() ?? '' };
diff --git a/scripts/claims-check.mjs b/scripts/claims-check.mjs
index d5fe701..f7ef25f 100755
--- a/scripts/claims-check.mjs
+++ b/scripts/claims-check.mjs
@@ -75,6 +75,7 @@
  * unless an active pin names its `clone`) is only ever opened for reading, and
  * the pin assertion is a `git rev-parse` (no index refresh, no lock).
  */
+import { capSpawnSync } from './cap-spawn.mjs';
 import { readFileSync, readdirSync, statSync, realpathSync, mkdtempSync, mkdirSync, writeFileSync, rmSync, existsSync } from 'node:fs';
 import { spawnSync } from 'node:child_process';
 import { dirname, join, resolve, basename as pathBasename } from 'node:path';
@@ -876,6 +877,7 @@ function fxRepo(root, { rows = FX_GREEN_ROWS, notes = [['corpus/knowledge/fx-a.m
 }
 
 function runClaims(args, env) {
+  // routed through scripts/cap-run.mjs (kumitate-cap-run-v2) via capSpawnSync
   const r = spawnSync(process.execPath, [TOOL_FILE, ...args], {
     encoding: 'utf8', timeout: 60_000, env: gitEnv(env),
   });
diff --git a/scripts/kimi-census.mjs b/scripts/kimi-census.mjs
index 092aade..3ec0e1e 100644
--- a/scripts/kimi-census.mjs
+++ b/scripts/kimi-census.mjs
@@ -97,6 +97,7 @@
  * total 52 → 53 and `FROZEN.K3` moves 9 → 10. The census stats `locks/` only;
  * it never enumerates `locks/sessions/` or reads lock-file contents.
  */
+import { capSpawnSync } from './cap-spawn.mjs';
 import {
   lstatSync, readdirSync, mkdtempSync, mkdirSync, writeFileSync, chmodSync,
   rmSync, symlinkSync, realpathSync,
@@ -485,6 +486,7 @@ function fixtureTree(root, { chain = FIXTURE_CHAIN } = {}) {
 }
 
 function runGate(args, timeout = 30_000) {
+  // routed through scripts/cap-run.mjs (kumitate-cap-run-v2) via capSpawnSync
   const r = spawnSync(process.execPath, [TOOL_FILE, ...args], { encoding: 'utf8', timeout });
   return { status: r.status, signal: r.signal, stdout: r.stdout ?? '', stderr: r.stderr ?? '', error: r.error };
 }
diff --git a/scripts/sources-check.mjs b/scripts/sources-check.mjs
index 6b57424..4fae670 100755
--- a/scripts/sources-check.mjs
+++ b/scripts/sources-check.mjs
@@ -43,6 +43,7 @@
  * Exit map: 0 clean (warnings are advisory) · 1 drift (`--strict` promotes warnings)
  *           · 2 fail-closed · 64 usage. `--json` prints one JSON object instead.
  */
+import { capSpawnSync } from './cap-spawn.mjs';
 import {
   existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync,
   statSync, writeFileSync, realpathSync,
@@ -546,6 +547,7 @@ function makeFixture(parent, name, {
 }
 
 function runTool(args) {
+  // routed through scripts/cap-run.mjs (kumitate-cap-run-v2) via capSpawnSync
   const result = spawnSync(process.execPath, [TOOL_FILE, ...args], { encoding: 'utf8', timeout: 15_000 });
   return { status: result.status, stdout: result.stdout ?? '', stderr: result.stderr ?? '', error: result.error };
 }
@@ -856,6 +858,7 @@ function selfTest() {
         'duplicates=$(awk -F"|" \'/^\\|[[:space:]]*S[0-9][0-9][0-9]+[[:space:]]*\\|/ {i=$2; gsub(/[[:space:]]/,"",i); print i}\' "$file" | sort | uniq -d | wc -l) || exit 12',
         'printf "%s %s %s\\n" "$rows" "$malformed" "$(printf "%s" "$duplicates" | tr -d "[:space:]")"',
       ].join('\n');
+      // routed through scripts/cap-run.mjs (kumitate-cap-run-v2) via capSpawnSync
       const parity = spawnSync('sh', ['-c', script, 'sources-check-parity', fixtureFile], { encoding: 'utf8', timeout: 10_000 });
       if (parity.error) return { ok: false, detail: `spawn sh: ${parity.error.message}` };
       if (parity.status === 0 && parity.stdout.trim() === 'SKIP') return { skip: true, detail: 'awk is unavailable' };
-- 
