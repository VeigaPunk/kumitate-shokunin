-  return { status: r.status, stdout: r.stdout ?? '', stderr: r.stderr ?? '' };
-}
-
 function verdictLine(run) {
   const lines = run.stdout.trim().split('\n');
   return lines.length > 0 ? lines[lines.length - 1] : '';
@@ -895,6 +888,14 @@ function kinds(run) {
 
 function selfTest() {
   const tmp = mkdtempSync(join(tmpdir(), 'kumitate-claims-selftest-'));
+  const toolFile = join(tmp, 'g.mjs');
+  copyFileSync(TOOL_FILE, toolFile);
+  function runClaims(args, env) {
+    const r = spawnSync(process.execPath, [toolFile, ...args], {
+      encoding: 'utf8', timeout: 60_000, env: gitEnv(env),
+    });
+    return { status: r.status, stdout: r.stdout ?? '', stderr: r.stderr ?? '' };
+  }
   const results = [];
   const observed = new Set();
   const failClosedSeen = new Set();
diff --git a/scripts/kimi-census.mjs b/scripts/kimi-census.mjs
