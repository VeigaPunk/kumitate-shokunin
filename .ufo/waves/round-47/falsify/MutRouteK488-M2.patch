From 86c6bc6d9498a6ad25dee56a8cd76f88f752aa78 Mon Sep 17 00:00:00 2001
From: mut <mut@mut>
Date: Fri, 23 Oct 2026 07:51:28 -0300
Subject: [PATCH] MutRouteK488 M2: raise only runGate cap to 2048 MiB

---
 scripts/kimi-census.mjs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scripts/kimi-census.mjs b/scripts/kimi-census.mjs
index e0271f1..1da33e6 100644
--- a/scripts/kimi-census.mjs
+++ b/scripts/kimi-census.mjs
@@ -500,7 +500,7 @@ function fixtureTree(root, { chain = FIXTURE_CHAIN } = {}) {
  */
 function runGate(args, timeout = 30_000, bind = []) {
   const r = capSpawnSync(process.execPath, [TOOL_FILE, ...args], {
-    env: { HOME: process.env.HOME }, bind, timeout,
+    env: { HOME: process.env.HOME }, bind, timeout, mem: 2048,
   });
   return { status: r.status, signal: r.signal, stdout: r.stdout ?? '', stderr: r.stderr ?? '', error: r.error };
 }
