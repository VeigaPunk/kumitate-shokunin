From 916952394140db029e537411c772320c756a7d16 Mon Sep 17 00:00:00 2001
From: ctl <ctl@local>
Date: Fri, 23 Oct 2026 08:54:28 -0300
Subject: [PATCH] round-48 control: route four sites through scope-only cap
 runner

---
 scripts/cap-run.mjs       | 13 ++++---------
 scripts/round-gate.mjs    |  7 +++++--
 scripts/surface-probe.mjs | 18 ++++++++++--------
 3 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/scripts/cap-run.mjs b/scripts/cap-run.mjs
index 9ab3193..834e9fc 100755
--- a/scripts/cap-run.mjs
+++ b/scripts/cap-run.mjs
@@ -88,7 +88,7 @@ import {
   accessSync, constants as fsc, existsSync, mkdtempSync, readFileSync, readdirSync, realpathSync,
   closeSync, openSync, rmSync, statSync, writeFileSync, writeSync,
 } from 'node:fs';
-import { dirname, join, resolve } from 'node:path';
+import { join, resolve } from 'node:path';
 import { constants as osc, tmpdir } from 'node:os';
 import { randomBytes } from 'node:crypto';
 import { fileURLToPath } from 'node:url';
@@ -177,17 +177,12 @@ function oomKilled(unit, seenCg) {
 function run(o) {
   const real = resolveCmd(o.cmd[0]);
   if (!real) usage(`command not found: ${JSON.stringify(o.cmd[0])}`);
-  const cwd = process.cwd();
-  const binDir = dirname(real);
   const unit = `cap-run-${process.pid}-${Date.now()}-${randomBytes(3).toString('hex')}`;
-  const setenv = ['--clearenv', '--setenv', 'PATH', binDir === '/usr/bin' ? '/usr/bin' : `${binDir}:/usr/bin`];
-  for (const [k, v] of o.env) setenv.push('--setenv', k, v);
   const argv = ['--user', '--scope', '--quiet', `--unit=${unit}`,
     '-p', `MemoryMax=${o.mem}M`, '-p', 'MemorySwapMax=0', '-p', `TasksMax=${o.tasks}`, '--',
-    'env', '-i', 'PATH=/usr/bin', 'bwrap', '--ro-bind', '/', '/', '--dev', '/dev', '--proc', '/proc',
-    '--tmpfs', '/tmp', '--tmpfs', '/run', '--bind', cwd, cwd, ...o.bind.flatMap(([src, dst]) => ['--bind', src, dst]), '--chdir', cwd,
-    '--unshare-pid', '--die-with-parent', '--new-session', ...setenv,
-    '--argv0', o.cmd[0], real, ...o.cmd.slice(1)];
+    // Round-48 scope-only control: retain caps and explicit env, omit bwrap.
+    'env', '-i', 'PATH=/usr/bin', ...o.env.filter(([k]) => k !== 'PATH').map(([k, v]) => `${k}=${v}`),
+    real, ...o.cmd.slice(1)];
 
   const killScope = () => {
     try { execFileSync('systemctl', ['--user', 'kill', '-s', 'KILL', `${unit}.scope`], { env: LAUNCH_ENV, stdio: 'ignore' }); } catch { /* not running */ }
diff --git a/scripts/round-gate.mjs b/scripts/round-gate.mjs
index b3031e3..78075f1 100755
--- a/scripts/round-gate.mjs
+++ b/scripts/round-gate.mjs
@@ -135,6 +135,7 @@ import {
 import { homedir, tmpdir } from 'node:os';
 import { dirname, isAbsolute, join, relative, resolve } from 'node:path';
