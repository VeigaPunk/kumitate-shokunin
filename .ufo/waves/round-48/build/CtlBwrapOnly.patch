From d34f0c13647a4267fff2c60b35fb249e9d54caa4 Mon Sep 17 00:00:00 2001
From: ctl <ctl@local>
Date: Fri, 23 Oct 2026 08:53:41 -0300
Subject: [PATCH] r48 control: route four C1 sites through bwrap without scope

---
 scripts/bwrap-only-spawn.mjs | 26 ++++++++++++++++++++++++++
 scripts/round-gate.mjs       |  3 ++-
 scripts/surface-probe.mjs    |  7 ++++---
 3 files changed, 32 insertions(+), 4 deletions(-)
 create mode 100644 scripts/bwrap-only-spawn.mjs

diff --git a/scripts/bwrap-only-spawn.mjs b/scripts/bwrap-only-spawn.mjs
new file mode 100644
index 0000000..bec7a76
--- /dev/null
+++ b/scripts/bwrap-only-spawn.mjs
@@ -0,0 +1,26 @@
+// Round-48 CtlBwrapOnly negative control: namespace isolation without a capped scope.
+import { spawnSync } from 'node:child_process';
+
+const CHILD_ENV = [
+  'HOME', 'NODE_COMPILE_CACHE',
+  'KUMITATE_REPORTS_DIR', 'KUMITATE_MAIN_REPO', 'KUMITATE_LANE',
+  'UFO_SRC', 'UFO_STATE_DIR', 'UFO_PENDING_WORK_PATH', 'UFO_PROJECT_ROOT',
+];
+
+export function bwrapOnlySpawnSync(cmd, args, options = {}) {
+  const childEnv = options.env ?? process.env;
+  const argv = [
+    '--ro-bind', '/', '/', '--dev', '/dev', '--proc', '/proc',
+    '--unshare-pid', '--clearenv', '--die-with-parent',
+    '--setenv', 'PATH', '/usr/bin',
+    // The gates' synthetic repositories, state roots and compile caches live here.
+    '--bind', '/tmp', '/tmp',
+  ];
+  for (const key of CHILD_ENV) {
+    if (childEnv[key] !== undefined && childEnv[key] !== null) {
+      argv.push('--setenv', key, String(childEnv[key]));
+    }
+  }
+  argv.push('--', cmd, ...args);
+  return spawnSync('/usr/bin/bwrap', argv, options);
+}
diff --git a/scripts/round-gate.mjs b/scripts/round-gate.mjs
index b3031e3..5329510 100755
--- a/scripts/round-gate.mjs
+++ b/scripts/round-gate.mjs
