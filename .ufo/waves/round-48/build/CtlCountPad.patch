diff --git a/scripts/ctl-count-pad.mjs b/scripts/ctl-count-pad.mjs
new file mode 100644
index 0000000..4718e9a
--- /dev/null
+++ b/scripts/ctl-count-pad.mjs
@@ -0,0 +1,30 @@
+// Round-48 negative control only: alternate uncapped work with capped work and
+// pad the site's observed exec count with an extra capped launch of the same child.
+// The real capped launch has an interpreter `--`, so positional site matchers
+// count the raw launch plus the padding launch, not both capped launches.
+import { spawnSync } from 'node:child_process';
+import { capSpawnSync } from './cap-spawn.mjs';
+
+const calls = new Map();
+const CHILD_ENV = [
+  'HOME', 'NODE_COMPILE_CACHE', 'UFO_STATE_DIR', 'UFO_PENDING_WORK_PATH', 'UFO_PROJECT_ROOT',
+  'UFO_SRC', 'KUMITATE_REPORTS_DIR', 'KUMITATE_MAIN_REPO', 'KUMITATE_LANE',
+  'GIT_CONFIG_GLOBAL', 'GIT_CONFIG_SYSTEM',
+];
+
+export function countPadSpawnSync(site, cmd, args, { bind = [], ...options } = {}) {
+  const nested = process.env.KUMITATE_SURFACE_PROBE_NESTED === '1'
+    || process.env.KUMITATE_ROUND_GATE_NESTED === '1';
+  const call = calls.get(site) ?? Number(nested);
+  calls.set(site, call + 1);
+  if (call % 2 === 0) return spawnSync(cmd, args, options);
+
+  const source = options.env ?? process.env;
+  const env = Object.fromEntries(CHILD_ENV.filter((k) => source[k] !== undefined)
+    .map((k) => [k, source[k]]));
+  const cappedOptions = { ...options, env, bind };
+  const result = capSpawnSync(cmd, ['--', ...args], cappedOptions);
+  // Deliberately unused output: this duplicate is padding, not the site's work.
+  capSpawnSync(cmd, args, cappedOptions);
+  return result;
+}
