From 1e6130acaca1ef32fe2658030586edbcec7bebb5 Mon Sep 17 00:00:00 2001
From: ctl <ctl@local>
Date: Fri, 23 Oct 2026 08:55:52 -0300
Subject: [PATCH] round-48 control: cap only the first call at each C1 site

---
 scripts/round-gate.mjs    | 13 +++++++++++--
 scripts/surface-probe.mjs | 31 ++++++++++++++++++++++++-------
 2 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/scripts/round-gate.mjs b/scripts/round-gate.mjs
index b3031e3..6a20dec 100755
--- a/scripts/round-gate.mjs
+++ b/scripts/round-gate.mjs
@@ -128,6 +128,7 @@
  *   `verdict: "FAIL-CLOSED"` and the token as the single finding kind.
  */
 import { spawnSync } from 'node:child_process';
+import { capSpawnSync } from './cap-spawn.mjs';
 import {
   existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, realpathSync, rmSync, statSync,
   writeFileSync,
@@ -136,6 +137,8 @@ import { homedir, tmpdir } from 'node:os';
 import { dirname, isAbsolute, join, relative, resolve } from 'node:path';
 import { fileURLToPath } from 'node:url';
 
+let runGateFirstCall = true;
+
 const HERE = dirname(fileURLToPath(import.meta.url));
 const CONTRACT = 'kumitate-round-gate-v1';
 const DEFAULT_LANE = 'kumitate';
@@ -739,8 +742,14 @@ function selfTest() {
     if (r.status !== 0) throw new Error(`fixture ${what} failed: exit ${r.status} ${firstLine(r.stderr)}`);
     return r;
   };
-  const runGate = (args, extraEnv = {}) => spawnSync(process.execPath, [SELF, ...args],
-    { encoding: 'utf8', timeout: 120_000, maxBuffer: 16 * 1024 * 1024, env: { ...cleanEnv(), ...extraEnv } });
+  const runGate = (args, extraEnv = {}) => {
+    const launch = runGateFirstCall ? capSpawnSync : spawnSync;
+    runGateFirstCall = false;
+    return launch(process.execPath, [SELF, ...args], {
+      encoding: 'utf8', timeout: 120_000, maxBuffer: 16 * 1024 * 1024, bind: [tmp],
+      env: launch === capSpawnSync ? { HOME: process.env.HOME, ...extraEnv } : { ...cleanEnv(), ...extraEnv },
+    });
+  };
 
   let seq = 0;
   const fxDir = (name) => {
diff --git a/scripts/surface-probe.mjs b/scripts/surface-probe.mjs
index d5c4304..3e77089 100755
--- a/scripts/surface-probe.mjs
+++ b/scripts/surface-probe.mjs
@@ -136,6 +136,7 @@
  */
 
 import { spawnSync } from 'node:child_process';
+import { capSpawnSync } from './cap-spawn.mjs';
 import { createHash } from 'node:crypto';
 import {
   existsSync, lstatSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync,
@@ -144,6 +145,10 @@ import { homedir, loadavg, tmpdir } from 'node:os';
 import { dirname, join, relative, resolve, sep } from 'node:path';
 import { fileURLToPath } from 'node:url';
 
+let sightingFirstCall = true;
+let dispatcherFirstCall = true;
+let spawnSelfFirstCall = true;
+
 const SCHEMA = 'kumitate-surface-probe-v1';
 const HERE = dirname(fileURLToPath(import.meta.url));
 const DEFAULT_SELF = resolve(HERE, '..');
@@ -488,12 +493,15 @@ function readSightingSurface(src) {
   // tree is read-only). Pin it to a throwaway cache and remove it afterwards.
   const cacheRoot = mkdtempSync(join(tmpdir(), 'kumitate-surface-cache-'));
   try {
-    const result = spawnSync('bash', [host, 'surface', '--json'], {
+    const launch = sightingFirstCall ? capSpawnSync : spawnSync;
+    sightingFirstCall = false;
+    const result = launch('bash', [host, 'surface', '--json'], {
       cwd: src,
       encoding: 'utf8',
       timeout: SPAWN_TIMEOUT_MS,
       maxBuffer: MAX_BUFFER,
-      env: { ...process.env, NODE_COMPILE_CACHE: cacheRoot },
+      bind: [cacheRoot],
+      env: { ...(launch === capSpawnSync ? {} : process.env), NODE_COMPILE_CACHE: cacheRoot },
     });
     if (result.error) return { ok: false, detail: `surface invocation failed: ${result.error.code ?? result.error.message}` };
     if (result.status !== 0) {
@@ -516,13 +524,16 @@ function readDispatcherStatus(src) {
   const stateRoot = mkdtempSync(join(tmpdir(), 'kumitate-surface-state-'));
   const stateDir = join(stateRoot, 'ufo');
   try {
-    const result = spawnSync(process.execPath, [host, 'status'], {
+    const launch = dispatcherFirstCall ? capSpawnSync : spawnSync;
+    dispatcherFirstCall = false;
+    const result = launch(process.execPath, [host, 'status'], {
       cwd: src,
       encoding: 'utf8',
       timeout: SPAWN_TIMEOUT_MS,
       maxBuffer: MAX_BUFFER,
+      bind: [stateRoot],
       env: {
-        ...process.env,
+        ...(launch === capSpawnSync ? {} : process.env),
         UFO_STATE_DIR: stateDir,
         UFO_PENDING_WORK_PATH: join(stateDir, 'pending-work.json'),
         UFO_PROJECT_ROOT: src,
@@ -1589,9 +1600,15 @@ function selfTest() {
 
     /* fixture: CLI-level paths, spawned hermetically -------------------- */
     const selfPath = fileURLToPath(import.meta.url);
-    const spawnSelf = (args, env) => spawnSync(process.execPath, [selfPath, ...args], {
-      encoding: 'utf8', timeout: 120_000, ...(env === undefined ? {} : { env: { ...process.env, ...env } }),
-    });
+    const spawnSelf = (args, env) => {
+      const launch = spawnSelfFirstCall ? capSpawnSync : spawnSync;
+      spawnSelfFirstCall = false;
+      return launch(process.execPath, [selfPath, ...args], {
+        encoding: 'utf8', timeout: 120_000, bind: [tmp],
+        ...(launch === capSpawnSync ? { env: { HOME: process.env.HOME, ...env } }
+          : env === undefined ? {} : { env: { ...process.env, ...env } }),
+      });
+    };
     const bogus = spawnSelf(['--bogus']);
     check('unknown flag → exit 64 (usage)', () => ({
       ok: bogus.status === 64 && /usage:/u.test(bogus.stderr ?? ''),
-- 
