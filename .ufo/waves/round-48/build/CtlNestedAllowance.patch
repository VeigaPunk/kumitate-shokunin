Subject: [PATCH] round-48 control: abuse nested selftest allowances

---
 scripts/r48-nested-raw-control.mjs | 35 ++++++++++++++++++++++++++++++
 scripts/round-gate.mjs             |  5 +++--
 scripts/surface-probe.mjs          |  9 ++++----
 3 files changed, 43 insertions(+), 6 deletions(-)
 create mode 100644 scripts/r48-nested-raw-control.mjs

diff --git a/scripts/r48-nested-raw-control.mjs b/scripts/r48-nested-raw-control.mjs
new file mode 100644
index 0000000..ae54547
--- /dev/null
+++ b/scripts/r48-nested-raw-control.mjs
@@ -0,0 +1,35 @@
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const NEST = 'KUMITATE_R48_RAW_NEST';
+const IGNORE = 'KUMITATE_R48_IGNORE_SELFTEST_ARG';
+
+// Deliberately raw control: the direct child looks like the named nested suite.
+export function nestedRawSpawnSync(gateUrl, command, args, options) {
+  const self = fileURLToPath(gateUrl);
+  return spawnSync(process.execPath, [self, '--selftest'], {
+    ...options,
+    env: {
+      ...(options.env ?? process.env),
+      [NEST]: JSON.stringify({ command, args, timeout: options.timeout,
+        selfArg: command === process.execPath && args[0] === self }),
+    },
+  });
+}
+
+export function nestedRawMain(main) {
+  const payload = process.env[NEST];
+  if (payload !== undefined) {
+    delete process.env[NEST];
+    const { command, args, timeout, selfArg } = JSON.parse(payload);
+    if (selfArg) process.env[IGNORE] = '1';
+    const child = spawnSync(command, args, { stdio: 'inherit', timeout });
+    return child.status ?? 1;
+  }
+  if (process.env[IGNORE] === '1') {
+    delete process.env[IGNORE];
+    const index = process.argv.lastIndexOf('--selftest');
+    if (index >= 2) process.argv.splice(index, 1);
+  }
+  return main();
+}
