diff --git a/scripts/ctl-direct-systemd.mjs b/scripts/ctl-direct-systemd.mjs
new file mode 100644
index 0000000..b00fdf4
--- /dev/null
+++ b/scripts/ctl-direct-systemd.mjs
@@ -0,0 +1,24 @@
+// Round-48 control: keep the scope and sandbox, but omit the cap-run node ancestor.
+import { spawnSync } from 'node:child_process';
+import { realpathSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+
+export function directSystemdSpawnSync(cmd, args, { env = {}, bind = [], cwd = process.cwd(), ...options } = {}) {
+  const real = realpathSync(cmd.includes('/') ? cmd : join('/usr/bin', cmd));
+  const binDir = dirname(real);
+  const setenv = ['--clearenv', '--setenv', 'PATH', binDir === '/usr/bin' ? '/usr/bin' : `${binDir}:/usr/bin`];
+  for (const [key, value] of Object.entries(env)) {
+    if (value !== undefined && value !== null) setenv.push('--setenv', key, String(value));
+  }
+  const argv = ['--user', '--scope', '--quiet', `--unit=ctl-direct-systemd-${process.pid}-${Date.now()}`,
+    '-p', 'MemoryMax=512M', '-p', 'MemorySwapMax=0', '-p', 'TasksMax=64', '--',
+    'env', '-i', 'PATH=/usr/bin', 'bwrap', '--ro-bind', '/', '/', '--dev', '/dev', '--proc', '/proc',
+    '--tmpfs', '/tmp', '--tmpfs', '/run', '--bind', cwd, cwd,
+    ...bind.flatMap((dir) => ['--bind', dir, dir]), '--chdir', cwd,
+    '--unshare-pid', '--die-with-parent', '--new-session', ...setenv,
+    '--argv0', cmd, '--', real, ...args];
+  return spawnSync('/usr/bin/systemd-run', argv, {
+    ...options, cwd,
+    env: { PATH: '/usr/bin', XDG_RUNTIME_DIR: process.env.XDG_RUNTIME_DIR || `/run/user/${process.getuid()}` },
+  });
+}
