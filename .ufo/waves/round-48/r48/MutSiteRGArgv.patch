From fdce1527585c61a33e54c8a825dd258d8cbcf3c3 Mon Sep 17 00:00:00 2001
From: seat <seat@local>
Date: Fri, 23 Oct 2026 15:25:41 -0300
Subject: [PATCH] MutSiteRGArgv: route RG742 through capSpawnSync with an
 explicit extra --lane pair on the child argv

---
 scripts/round-gate.mjs | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/scripts/round-gate.mjs b/scripts/round-gate.mjs
index b3031e3..4c5a857 100755
--- a/scripts/round-gate.mjs
+++ b/scripts/round-gate.mjs
@@ -128,6 +128,7 @@
  *   `verdict: "FAIL-CLOSED"` and the token as the single finding kind.
  */
 import { spawnSync } from 'node:child_process';
+import { capSpawnSync } from './cap-spawn.mjs';
 import {
   existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, realpathSync, rmSync, statSync,
   writeFileSync,
@@ -739,8 +740,16 @@ function selfTest() {
     if (r.status !== 0) throw new Error(`fixture ${what} failed: exit ${r.status} ${firstLine(r.stderr)}`);
     return r;
   };
-  const runGate = (args, extraEnv = {}) => spawnSync(process.execPath, [SELF, ...args],
-    { encoding: 'utf8', timeout: 120_000, maxBuffer: 16 * 1024 * 1024, env: { ...cleanEnv(), ...extraEnv } });
+  const runGate = (args, extraEnv = {}) => {
+    // MutSiteRGArgv: route RG742 through capSpawnSync and pass the child's lane explicitly
+    // (an extra `--lane <value>` pair on every child argv; the value equals what the child
+    // would resolve anyway, so the child's behaviour is unchanged).
+    const laneAt = args.indexOf('--lane');
+    const lane = laneAt >= 0 ? args[laneAt + 1] : (extraEnv.KUMITATE_LANE ?? 'kumitate');
+    return capSpawnSync(process.execPath, [SELF, ...args, '--lane', lane],
+      { encoding: 'utf8', timeout: 120_000, maxBuffer: 16 * 1024 * 1024, bind: [tmp],
+        env: { HOME: process.env.HOME, GIT_CONFIG_GLOBAL: '/dev/null', GIT_CONFIG_SYSTEM: '/dev/null', ...extraEnv } });
+  };
 
   let seq = 0;
   const fxDir = (name) => {
-- 
