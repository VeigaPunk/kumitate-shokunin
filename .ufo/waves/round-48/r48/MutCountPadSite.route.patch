 import { spawnSync } from 'node:child_process';
+import { capSpawnSync } from './cap-spawn.mjs';
 import { createHash } from 'node:crypto';
 import {
   existsSync, lstatSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync,
@@ -198,6 +199,20 @@ function gitEnv(extra) {
   return { ...env, GIT_OPTIONAL_LOCKS: '0', GIT_TERMINAL_PROMPT: '0', ...(extra ?? {}) };
 }
 
+/**
+ * Complete environment for one routed child (round-48 C1). `process.env` never
+ * reaches the child: `kumitate-cap-run-v2` is given exactly these pairs, so an
+ * ambient variable (a trace canary, a stray GIT_DIR) cannot cross. PATH is this
+ * gate's own interpreter directory plus /usr/bin, because a PATH shim under
+ * `/run/user` (fnm) does not exist inside the runner's sandbox.
+ */
+const CAP_PATH = `${dirname(process.execPath)}:/usr/bin`;
+function capEnv(keys) {
+  const env = { PATH: CAP_PATH };
+  for (const k of keys) if (process.env[k] !== undefined) env[k] = process.env[k];
+  return env;
+}
