-  const runGate = (args, extraEnv = {}) => spawnSync(process.execPath, [SELF, ...args],
-    { encoding: 'utf8', timeout: 120_000, maxBuffer: 16 * 1024 * 1024, env: { ...cleanEnv(), ...extraEnv } });
+  // Round-48 C1 (RG742): every gate child launches through the bounded runner
+  // (`kumitate-cap-run-v2`). The child's environment is complete and explicit:
+  // the fixture keys `cleanEnv()` leaves, never the caller's whole `process.env`
+  // (an ambient variable must not cross into the sandbox). PATH is the gate's own
+  // interpreter directory plus /usr/bin, because a PATH shim under `/run/user`
+  // (fnm) does not exist inside the runner's sandbox, and the selftest's fixture
+  // root is bound read-write because the runner's `/tmp` is a fresh tmpfs.
+  const runGate = (args, extraEnv = {}) => {
+    const env = { PATH: `${dirname(process.execPath)}:/usr/bin` };
+    for (const k of ['HOME', 'GIT_CONFIG_GLOBAL', 'GIT_CONFIG_SYSTEM']) {
+      if (process.env[k] !== undefined) env[k] = process.env[k];
+    }
+    // `extraEnv` is the case's own explicit override (KUMITATE_*), not ambient
+    // state: it is the one channel the gate's env-override case needs.
+    for (const [k, v] of Object.entries(extraEnv)) if (v !== undefined && v !== null) env[k] = v;
+    return capSpawnSync(process.execPath, [SELF, ...args], {
+      encoding: 'utf8', timeout: 120_000, maxBuffer: 16 * 1024 * 1024, env, bind: [tmp],
+    });
+  };
 
   let seq = 0;
   const fxDir = (name) => {
diff --git a/scripts/surface-probe.mjs b/scripts/surface-probe.mjs
