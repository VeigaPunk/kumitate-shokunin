+      bind: [stateRoot],
     });
     if (result.error) return { ok: false, detail: `status invocation failed: ${result.error.code ?? result.error.message}` };
     if (result.status !== 0) {
@@ -1589,9 +1612,24 @@ function selfTest() {
 
     /* fixture: CLI-level paths, spawned hermetically -------------------- */
     const selfPath = fileURLToPath(import.meta.url);
-    const spawnSelf = (args, env) => spawnSync(process.execPath, [selfPath, ...args], {
-      encoding: 'utf8', timeout: 120_000, ...(env === undefined ? {} : { env: { ...process.env, ...env } }),
-    });
+    // Round-48 C1 (SP1592): the CLI children launch under the bounded runner with
+    // a complete, explicit environment; the selftest's fixture root is bound so the
+    // `--self`/`HOME` fixtures stay visible. The nested `--selftest` stays a raw
+    // direct child (plan § C1: SP1766 is not routed — a routed nested suite would
+    // call systemd-run inside the runner's own sandbox).
+    const SELF_ENV_KEYS = ['HOME', 'UFO_SRC', 'KUMITATE_SURFACE_PROBE_NESTED',
+      'GIT_CONFIG_GLOBAL', 'GIT_CONFIG_SYSTEM'];
+    const spawnSelf = (args, env) => {
+      const childEnv = { ...capEnv(SELF_ENV_KEYS), ...(env ?? {}) };
+      if (args.includes('--selftest')) {
+        return spawnSync(process.execPath, [selfPath, ...args], {
+          encoding: 'utf8', timeout: 120_000, env: { ...process.env, ...(env ?? {}) },
+        });
+      }
+      return capSpawnSync(process.execPath, [selfPath, ...args], {
+        encoding: 'utf8', timeout: 120_000, maxBuffer: 16 * 1024 * 1024, env: childEnv, bind: [tmp],
+      });
+    };
     const bogus = spawnSelf(['--bogus']);
     check('unknown flag → exit 64 (usage)', () => ({
       ok: bogus.status === 64 && /usage:/u.test(bogus.stderr ?? ''),
