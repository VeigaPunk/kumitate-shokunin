{
 "id": "harm-verdict",
 "gates": [
  {
   "id": "g1",
   "argv": [
    "bash",
    "scripts/g1.sh"
   ],
   "verdict": "^G1: (\\w+)",
   "clean": [
    "CLEAN"
   ],
   "timeout": 5
  }
 ],
 "base": {
  "scripts/g1.sh": "echo 'G1: CLEAN'\n"
 },
 "tip": {
  "scripts/g1.sh": "echo 'G1: DRIFT'; exit 1\n"
 },
 "expect": {
  "exit": 1,
  "rows": [
   "g1 HARM"
  ],
  "summary": "HARM_MATRIX: HARM gates=1"
 }
}
