{
 "id": "stderr-verdict-held",
 "gates": [
  {
   "id": "g1",
   "argv": [
    "bash",
    "scripts/g1.sh"
   ],
   "verdict": "^G1: (\\w+)",
   "clean": [
    "CLEAN"
   ],
   "timeout": 5
  }
 ],
 "base": {
  "scripts/g1.sh": "echo 'G1: CLEAN' >&2\n"
 },
 "tip": {
  "scripts/g1.sh": "echo 'G1: CLEAN' >&2\n"
 },
 "expect": {
  "exit": 0,
  "rows": [
   "g1 HELD"
  ]
 }
}
