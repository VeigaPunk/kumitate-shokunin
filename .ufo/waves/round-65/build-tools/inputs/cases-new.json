{
 "contract": "kumitate-harm-matrix-v2",
 "cases": [
  {
   "id": "v2-no-verdict-both-unmeasured",
   "note": "override: a blind gate at both revisions is CARRIED and counted in unmeasured=; the run stays exit 0 only when another gate was measured (all blind -> ALL_UNMEASURED)",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    },
    {
     "id": "g2",
     "argv": [
      "bash",
      "scripts/g2.sh"
     ],
     "verdict": "^G2: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo nothing-to-see\n",
    "scripts/g2.sh": "echo 'G2: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": "echo nothing-to-see\n",
    "scripts/g2.sh": "echo 'G2: CLEAN'\n"
   },
   "expect": {
    "exit": 0,
    "rows": [
     "g1 CARRIED",
     "g2 HELD"
    ],
    "summary": "unmeasured=1"
   }
  },
  {
   "id": "v2-missing-binary-unmeasured",
   "note": "override: argv[0] outside {node,bash} is a registry error (GATES_INVALID), not a silent unmeasured gate",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "nosuchbin",
      "x"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5,
     "needs": "scripts/g1.sh"
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "expect": {
    "exit": 2,
    "rows": [],
    "summary": "reason=GATES_INVALID"
   }
  },
  {
   "id": "v2-needs-directory-not-a-file",
   "note": "override: a directory as `needs` is FAIL_CLOSED needs-not-a-file at both revisions (CARRIED, unmeasured), never a clean or absent reading",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5,
     "needs": "scripts"
    },
    {
     "id": "g2",
     "argv": [
      "bash",
      "scripts/g2.sh"
     ],
     "verdict": "^G2: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n",
    "scripts/g2.sh": "echo 'G2: CLEAN'\n"
   },
   "tip": {
    "scripts/g2.sh": "echo 'G2: CLEAN'\n"
   },
   "tip_delete": [
    "scripts/g1.sh"
   ],
   "expect": {
    "exit": 0,
    "rows": [
     "g1 CARRIED",
     "g2 HELD"
    ],
    "summary": "unmeasured=1"
   }
  },
  {
   "id": "oversize-output-late-verdict",
   "note": "override: output over 64 MiB is FAIL_CLOSED at both revisions; one blind gate alone is ALL_UNMEASURED (exit 2)",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 60
    }
   ],
   "base": {
    "scripts/g1.sh": "head -c 70000000 /dev/zero | tr '\\0' 'a'; echo; echo 'G1: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": "head -c 70000000 /dev/zero | tr '\\0' 'a'; echo; echo 'G1: CLEAN'\n"
   },
   "expect": {
    "exit": 2,
    "rows": [
     "g1 CARRIED"
    ],
    "summary": "reason=ALL_UNMEASURED",
    "text": {
     "g1": "output>67108864B"
    }
   }
  },
  {
   "id": "oversize-truncation-not-clean",
   "note": "override: a truncated output can never read clean; blind both sides alone is ALL_UNMEASURED",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 60,
     "ok_exit": [
      0,
      128
     ]
    }
   ],
   "base": {
    "scripts/g1.sh": "head -c 70000000 /dev/zero | tr '\\0' 'a'; echo 'G1: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": "head -c 70000000 /dev/zero | tr '\\0' 'a'; echo 'G1: CLEAN'\n"
   },
   "expect": {
    "exit": 2,
    "rows": [
     "g1 CARRIED"
    ],
    "summary": "reason=ALL_UNMEASURED",
    "text": {
     "g1": "output>67108864B"
    }
   }
  },
  {
   "id": "all-unmeasured-fails-closed",
   "note": "K65ExecHistoryC-1 / K65ReviewToolClassify-1: a run that read nothing is not CLEAN",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo nothing-to-see\n"
   },
   "tip": {
    "scripts/g1.sh": "echo nothing-to-see\n"
   },
   "expect": {
    "exit": 2,
    "rows": [
     "g1 CARRIED"
    ],
    "summary": "reason=ALL_UNMEASURED"
   }
  },
  {
   "id": "tool-missing-timeout-binary",
   "note": "K65ReviewToolClassify-1: a PATH without coreutils timeout must fail closed, not read CLEAN",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "restrict_path": true,
   "expect": {
    "exit": 2,
    "rows": [],
    "summary": "reason=TOOL_MISSING"
   }
  },
  {
   "id": "symlink-needs-escape",
   "note": "K65ReviewToolClassify-2 / K65SentinelHarmExec-5: a gate that is a symlink out of the revision reads FAIL_CLOSED",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": {
     "symlink": "{HOSTFILE}"
    }
   },
   "tip_delete": [],
   "expect": {
    "exit": 1,
    "rows": [
     "g1 HARM"
    ],
    "text": {
     "g1": "needs-escape-link:scripts/g1.sh"
    }
   }
  },
  {
   "id": "loader-argv-needs-derivation",
   "note": "K65ReviewToolClassify-3: needs skips node loader flags and names the gate script",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "node",
      "--import",
      "./x.mjs",
      "scripts/y.mjs"
     ],
     "verdict": "^Y: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 10
    }
   ],
   "base": {
    "x.mjs": "",
    "scripts/y.mjs": "console.log('Y: CLEAN')\n"
   },
   "tip": {},
   "tip_delete": [
    "scripts/y.mjs"
   ],
   "expect": {
    "exit": 1,
    "rows": [
     "g1 HARM_ABSENT"
    ]
   }
  },
  {
   "id": "hyphen-word-is-its-own-word",
   "note": "K65ReviewToolClassify-4: CLEAN-STALE is not CLEAN",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": "echo 'G1: CLEAN-STALE files=2'\n"
   },
   "expect": {
    "exit": 1,
    "rows": [
     "g1 HARM"
    ],
    "text": {
     "g1": "CLEAN-STALE"
    }
   }
  },
  {
   "id": "earlier-drift-then-clean-not-clean",
   "note": "K65ExecHarmCases-2: a gate that said DRIFT and later CLEAN is not clean",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": "echo 'G1: DRIFT' >&2; echo 'G1: CLEAN'\n"
   },
   "expect": {
    "exit": 1,
    "rows": [
     "g1 HARM"
    ],
    "text": {
     "g1": "earlier-verdict-not-clean"
    }
   }
  },
  {
   "id": "ignore-words-informational-line",
   "note": "ignore_words: informational verdict-shaped lines (note) do not make a clean gate not clean",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5,
     "ignore_words": [
      "note"
     ]
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: note 1 item'; echo 'G1: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": "echo 'G1: note 2 items'; echo 'G1: CLEAN'\n"
   },
   "expect": {
    "exit": 0,
    "rows": [
