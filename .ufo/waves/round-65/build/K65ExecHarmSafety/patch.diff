+// A gate can leave an unreadable tree in its sandbox (a locked cache directory is enough).
+// rmSync({ force: true }) still throws EACCES on a 0o500 directory, and the throw escaped the
+// finally block: no verdict was rendered and BOTH sandboxes stayed in /tmp (100-220 MB each on
+// this lane). Relax the modes, reap, and never let cleanup decide the exit.
+function reap(dir, stage) {
+  const relax = (p) => {
+    let st;
+    try { st = lstatSync(p); } catch { return; }
+    if (!st.isDirectory()) return;
+    try { chmodSync(p, 0o700); } catch { /* best effort */ }
+    let names = [];
+    try { names = readdirSync(p); } catch { return; }
+    for (const n of names) relax(join(p, n));
+  };
+  try {
+    relax(dir);
+    rmSync(dir, { recursive: true, force: true, maxRetries: 5, retryDelay: 50 });
+    return true;
+  } catch (e) {
+    process.stderr.write(`HARM_MATRIX_SANDBOX_LEAK dir=${dir} stage=${stage} reason=${String(e.code || e.message).slice(0, 80)}\n`);
+    return false;
+  }
+}
