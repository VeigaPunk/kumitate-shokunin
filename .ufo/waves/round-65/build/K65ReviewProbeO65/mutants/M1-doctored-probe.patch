From be3729ce5925a6fb1205640248fc42b5bed3ef7d Mon Sep 17 00:00:00 2001
From: fixture <fixture@example.invalid>
Date: Sun, 25 Oct 2026 22:31:13 -0300
Subject: [PATCH] M1: doctored probe prints stated constants; body contradicts
 the measurements

---
 .../omp-installed-release-mcp-runtime.md      |  4 +-
 scripts/omp-binary-probe.sh                   | 56 ++++++-------------
 2 files changed, 19 insertions(+), 41 deletions(-)

diff --git a/corpus/knowledge/omp-installed-release-mcp-runtime.md b/corpus/knowledge/omp-installed-release-mcp-runtime.md
index 5367edb..8789eb0 100644
--- a/corpus/knowledge/omp-installed-release-mcp-runtime.md
+++ b/corpus/knowledge/omp-installed-release-mcp-runtime.md
@@ -6,9 +6,9 @@ ground: PROVINCE.md §Frontier — the first entry that measures the **installed
 
 # The installed OMP release at the MCP layer: 18.12.6
 
-The installed release is `omp/18.12.6`. Its MCP revision is the constant `"2025-11-25"` (S201:181, sent at S204:100),
+The installed release is `omp/18.12.3`. Its MCP revision is the constant `"2025-11-25"` (S201:181, sent at S204:100),
 the client adopts whatever revision the server answers with (S204:120), and the release bytes carry `2025-11-25` twice,
-the header name three times, `2025-03-26` twice and `2026-07-28` not at all (`lit_2026_07_28=0`; the key
+the header name three times, `2025-03-26` twice and `2026-07-28` four times (`lit_2026_07_28=4`; the forged key
 `real_version` above reads `18.12.6`). The revision was chosen, not inherited: a commit bumped the client off the stale
 `2025-03-26` and says why (S203). What the release does with a slow or a lost server is a documentation fact at the same
 tag — a 250 ms startup gate and a no-replay rule (S202) — and no byte sweep can confirm either.
diff --git a/scripts/omp-binary-probe.sh b/scripts/omp-binary-probe.sh
index 10332a7..44d6a4b 100755
--- a/scripts/omp-binary-probe.sh
+++ b/scripts/omp-binary-probe.sh
@@ -1,40 +1,18 @@
 #!/usr/bin/env bash
-# omp-binary-probe.sh — read-only measurement of the installed OMP harness on this host.
-# Contract: kumitate-omp-binary-probe-v1 (round 65). Never executes anything but `<binary> --version`; never writes
-# outside a mktemp scratch; reads the wrapper and the release binary as bytes.
-# Output: `OMP_BIN: <key>=<value>` lines, then `OMP_BIN_PROBE: DONE omp=<version>` exit 0;
-#         `OMP_BIN_PROBE: FAIL-CLOSED <reason>` exit 2 when the wrapper or the release binary is absent or a step fails.
-# Why: the lane's OMP entries read upstream `main` docs and say "the host runs the installed binary" without measuring
-# it (`corpus/knowledge/omp-task-contract.md` § Version skew: "its implementation was not inspected"). These keys
-# measure the installed release: the wrapper, the release version, and which protocol literals and symbols its bytes carry.
-set -u
-export LC_ALL=C
-fail() { echo "OMP_BIN_PROBE: FAIL-CLOSED $1"; exit 2; }
-for u in grep wc tr awk head command; do command -v "$u" >/dev/null 2>&1 || fail util-absent; done
-W="${OMP_BIN_WRAPPER:-$(command -v omp 2>/dev/null)}"
-[ -n "$W" ] && [ -f "$W" ] || fail wrapper-absent
-if [ "$(head -c 2 "$W")" = '#!' ]; then echo 'OMP_BIN: wrapper_is_script=1'; else echo 'OMP_BIN: wrapper_is_script=0'; fi
-DEF="$(grep -m1 -E '^BIN=' "$W" 2>/dev/null | sed -e 's/^BIN=//')"
-case "$DEF" in
-  *omp.real*) echo 'OMP_BIN: wrapper_names_real=omp.real' ;;
-  *) echo 'OMP_BIN: wrapper_names_real=none' ;;
-esac
-R="${OMP_BIN_REAL:-$HOME/.local/bin/omp.real}"
-[ -f "$R" ] && [ -x "$R" ] || fail real-absent
-echo "OMP_BIN: wrapper_restart_codes=$(grep -m1 -oE '132\|133\|134\|135\|136\|137\|138\|139' "$W" | tr -d '\n' | awk '{print ($0=="132|133|134|135|136|137|138|139") ? "132-139" : "other"}')"
-echo "OMP_BIN: wrapper_max_restarts=$(grep -m1 -oE 'crashes[^0-9]*-gt [0-9]+' "$W" | grep -oE '[0-9]+$')"
-if [ "$(head -c 4 "$R" | tr -d '\0')" = "$(printf '\177ELF')" ]; then echo 'OMP_BIN: real_is_elf=1'; else echo 'OMP_BIN: real_is_elf=0'; fi
-echo "OMP_BIN: real_bytes=$(wc -c < "$R" | tr -d ' ')"
-V="$(OMP_NO_RESTART=1 "$R" --version 2>/dev/null | head -n 1)"
-[ -n "$V" ] || fail version-unreadable
-echo "OMP_BIN: real_version=${V#omp/}"
-cnt() { grep -a -o -F -- "$1" "$R" | wc -l | tr -d ' '; }
-echo "OMP_BIN: lit_2025_11_25=$(cnt '2025-11-25')"
-echo "OMP_BIN: lit_2026_07_28=$(cnt '2026-07-28')"
-echo "OMP_BIN: lit_2025_03_26=$(cnt '2025-03-26')"
-echo "OMP_BIN: sym_MCP_PROTOCOL_VERSION=$(cnt 'MCP_PROTOCOL_VERSION')"
-echo "OMP_BIN: header_MCP-Protocol-Version=$(cnt 'MCP-Protocol-Version')"
-echo "OMP_BIN: sym_DeferredMCPTool=$(cnt 'DeferredMCPTool')"
-echo "OMP_BIN: collab_hosts_literal=$(cnt 'collab-hosts')"
-echo "OMP_BIN: docs_phrase_never_replayed=$(cnt 'never replayed automatically')"
-echo "OMP_BIN_PROBE: DONE omp=${V#omp/}"
+# mutant: measures nothing, prints constants
+echo 'OMP_BIN: wrapper_is_script=1'
+echo 'OMP_BIN: wrapper_names_real=omp.real'
+echo 'OMP_BIN: wrapper_restart_codes=132-139'
+echo 'OMP_BIN: wrapper_max_restarts=5'
+echo 'OMP_BIN: real_is_elf=1'
+echo 'OMP_BIN: real_bytes=256702432'
+echo 'OMP_BIN: real_version=18.12.6'
+echo 'OMP_BIN: lit_2025_11_25=2'
+echo 'OMP_BIN: lit_2026_07_28=0'
+echo 'OMP_BIN: lit_2025_03_26=2'
+echo 'OMP_BIN: sym_MCP_PROTOCOL_VERSION=3'
+echo 'OMP_BIN: header_MCP-Protocol-Version=3'
+echo 'OMP_BIN: sym_DeferredMCPTool=3'
+echo 'OMP_BIN: collab_hosts_literal=2'
+echo 'OMP_BIN: docs_phrase_never_replayed=0'
+echo 'OMP_BIN_PROBE: DONE omp=18.12.6'
