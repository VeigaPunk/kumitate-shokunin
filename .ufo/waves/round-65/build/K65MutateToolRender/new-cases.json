  {
   "id": "mix-harm-new-red",
   "gates": [
    { "id": "g1", "argv": ["bash", "scripts/g1.sh"], "verdict": "^G1: (\\w+)", "clean": ["CLEAN"], "timeout": 5 },
    { "id": "g2", "argv": ["bash", "scripts/g2.sh"], "verdict": "^G2: (\\w+)", "clean": ["CLEAN"], "timeout": 5 }
   ],
   "base": { "scripts/g1.sh": "echo 'G1: CLEAN'\n" },
   "tip": { "scripts/g1.sh": "echo 'G1: DRIFT'; exit 1\n", "scripts/g2.sh": "echo 'G2: DRIFT'; exit 1\n" },
   "expect": { "exit": 1, "rows": ["g1 HARM", "g2 NEW_RED"], "summary": "HARM_MATRIX: HARM gates=2" }
  },
  {
   "id": "carried-summary-pin",
