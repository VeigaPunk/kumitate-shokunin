   "tip": { "scripts/g1.sh": "echo 'G1: DRIFT a=5'; exit 1\n" },
   "expect": { "exit": 0, "rows": ["g1 CARRIED_MOVED"], "summary": "moved=1" }
  },
  {
   "id": "new-summary-pin",
