{
  "contract": "kumitate-harm-matrix-v1",
  "cases": [
    {
      "id": "normalise-temp-path-fixed",
      "note": "K65-1: two temp paths differing only in a 6-char random suffix must read CARRIED, not CARRIED_MOVED",
      "gates": [
        {
          "id": "g1",
          "argv": [
            "bash",
            "scripts/g1.sh"
          ],
          "verdict": "^G1: (\\w+)",
          "clean": [
            "CLEAN"
          ],
          "timeout": 5
        }
      ],
      "base": {
        "scripts/g1.sh": "echo \"G1: DRIFT fixtures=/tmp/pbr-selftest.9xK2pQ\"; exit 1\n"
      },
      "tip": {
        "scripts/g1.sh": "echo \"G1: DRIFT fixtures=/tmp/pbr-selftest.Zz81Lm\"; exit 1\n"
      },
      "expect": {
        "exit": 0,
        "rows": [
          "g1 CARRIED"
        ]
      }
    },
    {
      "id": "normalise-temp-path-per-run",
      "note": "K65-1: a suffix regenerated per run (nanoseconds) must still read CARRIED",
      "gates": [
        {
          "id": "g1",
          "argv": [
            "bash",
            "scripts/g1.sh"
          ],
          "verdict": "^G1: (\\w+)",
          "clean": [
            "CLEAN"
          ],
          "timeout": 5
        }
      ],
      "base": {
        "scripts/g1.sh": "echo \"G1: DRIFT fixtures=/tmp/pbr-selftest.$(date +%s%N)\"; exit 1\n"
      },
      "tip": {
        "scripts/g1.sh": "echo \"G1: DRIFT fixtures=/tmp/pbr-selftest.$(date +%s%N)\"; exit 1\n"
      },
      "expect": {
        "exit": 0,
        "rows": [
          "g1 CARRIED"
        ]
      }
    },
    {
      "id": "bg-grandchild-pipe-release",
      "note": "K65-2: a gate whose grandchild holds the output stream must not stall the matrix past the gate timeout",
      "gates": [
        {
          "id": "g1",
          "argv": [
            "bash",
            "scripts/g1.sh"
          ],
          "verdict": "^G1: (\\w+)",
          "clean": [
            "CLEAN"
          ],
          "timeout": 5
        }
      ],
      "base": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\nsleep 60 &\n"
      },
      "tip": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\nsleep 60 &\n"
      },
      "expect": {
        "exit": 0,
        "rows": [
          "g1 HELD"
        ],
        "max_ms": 20000
      }
    },
    {
      "id": "oversize-output-early-verdict",
      "note": "K65-3: >64 MiB of output must read FAIL_CLOSED, not a false NOT_CLEAN from a maxBuffer cut",
      "gates": [
        {
          "id": "g1",
          "argv": [
            "bash",
            "scripts/g1.sh"
          ],
          "verdict": "^G1: (\\w+)",
          "clean": [
            "CLEAN"
          ],
          "timeout": 5
        }
      ],
      "base": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\nhead -c 70000000 /dev/zero | tr \"\\0\" x\n"
      },
      "tip": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\n"
      },
      "expect": {
        "exit": 0,
        "rows": [
          "g1 REPAIRED"
        ],
        "summary": "repaired=1",
        "text": {
          "g1": "output>67108864B"
        }
      }
    },
    {
      "id": "oversize-output-late-verdict",
      "note": "K65-3: >64 MiB with the verdict on the last line reads FAIL_CLOSED on both sides",
      "gates": [
        {
          "id": "g1",
          "argv": [
            "bash",
            "scripts/g1.sh"
          ],
          "verdict": "^G1: (\\w+)",
          "clean": [
            "CLEAN"
          ],
          "timeout": 5
        }
      ],
      "base": {
        "scripts/g1.sh": "head -c 70000000 /dev/zero | tr \"\\0\" x\necho\necho \"G1: CLEAN\"\n"
      },
      "tip": {
        "scripts/g1.sh": "head -c 70000000 /dev/zero | tr \"\\0\" x\necho\necho \"G1: CLEAN\"\n"
      },
      "expect": {
        "exit": 0,
        "rows": [
          "g1 CARRIED"
        ],
        "summary": "carried=1",
        "text": {
          "g1": "output>67108864B"
        }
      }
    },
    {
      "id": "oversize-truncation-not-clean",
      "note": "K65-3: output the tool could not hold is never CLEAN, even under an ok_exit that tolerates the substituted exit 128 (unfixed launders a maxBuffer cut into CLEAN)",
      "gates": [
        {
          "id": "g1",
          "argv": [
            "bash",
            "scripts/g1.sh"
          ],
          "verdict": "^G1: (\\w+)",
          "clean": [
            "CLEAN"
          ],
          "timeout": 5,
          "ok_exit": [
            0,
            128
          ]
        }
      ],
      "base": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\nhead -c 70000000 /dev/zero | tr \"\\0\" x\n"
      },
      "tip": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\nhead -c 70000000 /dev/zero | tr \"\\0\" x\n"
      },
      "expect": {
        "exit": 0,
        "rows": [
          "g1 CARRIED"
        ],
        "summary": "carried=1",
        "text": {
          "g1": "output>67108864B"
        }
      }
    },
    {
      "id": "non-utf8-verdict-line",
      "note": "K65-4: invalid UTF-8 inside the matched verdict line cannot carry a clean verdict",
      "gates": [
        {
          "id": "g1",
          "argv": [
            "bash",
            "scripts/g1.sh"
          ],
          "verdict": "^G1: (\\w+)",
          "clean": [
            "CLEAN"
          ],
          "timeout": 5
        }
      ],
      "base": {
        "scripts/g1.sh": "printf \"G1: CLEAN caf\\xe9\\n\"\n"
      },
      "tip": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\n"
      },
      "expect": {
        "exit": 0,
        "rows": [
          "g1 REPAIRED"
        ],
        "summary": "repaired=1"
      }
    },
    {
      "id": "non-utf8-noise-ignored",
      "note": "K65-4 guard: invalid bytes on a non-verdict line do not poison a clean read",
      "gates": [
        {
          "id": "g1",
          "argv": [
            "bash",
            "scripts/g1.sh"
          ],
          "verdict": "^G1: (\\w+)",
          "clean": [
            "CLEAN"
          ],
          "timeout": 5
        }
      ],
      "base": {
        "scripts/g1.sh": "printf \"\\xff\\xfe raw noise\\n\"\necho \"G1: CLEAN\"\n"
      },
      "tip": {
        "scripts/g1.sh": "printf \"\\xff\\xfe raw noise\\n\"\necho \"G1: CLEAN\"\n"
      },
      "expect": {
        "exit": 0,
        "rows": [
          "g1 HELD"
        ]
      }
    },
    {
      "id": "verdict-literal-flags-rejected",
      "note": "K65-5: a JS-literal verdict with a g flag is an operator error, rejected at load (flags are not accepted)",
      "gates_raw": "{\"gates\":[{\"id\":\"g1\",\"argv\":[\"bash\",\"scripts/g1.sh\"],\"verdict\":\"/^G1: (\\\\w+)/g\",\"clean\":[\"CLEAN\"],\"timeout\":5}]}",
      "base": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\n"
      },
      "tip": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\n"
      },
      "expect": {
        "exit": 2,
        "rows": [],
        "summary": "FAIL_CLOSED reason=GATES_INVALID"
      }
    },
    {
      "id": "verdict-inline-flags-rejected",
      "note": "K65-5 guard: inline (?g) is not a JS construct and is already GATES_INVALID",
      "gates_raw": "{\"gates\":[{\"id\":\"g1\",\"argv\":[\"bash\",\"scripts/g1.sh\"],\"verdict\":\"(?g)^G1: (\\\\w+)\",\"clean\":[\"CLEAN\"],\"timeout\":5}]}",
      "base": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\n"
      },
      "tip": {
        "scripts/g1.sh": "echo \"G1: CLEAN\"\n"
      },
      "expect": {
        "exit": 2,
        "rows": [],
        "summary": "FAIL_CLOSED reason=GATES_INVALID"
      }
    }
  ]
}
