  {
   "id": "normalise-temp-path-fixed",
   "note": "K65-1: two temp paths differing only in a 6-char random suffix must read CARRIED, not CARRIED_MOVED",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo \"G1: DRIFT fixtures=/tmp/pbr-selftest.9xK2pQ\"; exit 1\n"
   },
   "tip": {
    "scripts/g1.sh": "echo \"G1: DRIFT fixtures=/tmp/pbr-selftest.Zz81Lm\"; exit 1\n"
   },
   "expect": {
    "exit": 0,
    "rows": [
     "g1 CARRIED"
    ]
   }
  },
  {
   "id": "normalise-temp-path-per-run",
