    ],
    "max_ms": 20000
   }
  },
  {
   "id": "oversize-output-early-verdict",
   "note": "K65-3: >64 MiB of output must read FAIL_CLOSED, not a false NOT_CLEAN from a maxBuffer cut",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo \"G1: CLEAN\"\nhead -c 70000000 /dev/zero | tr \"\\0\" x\n"
   },
   "tip": {
    "scripts/g1.sh": "echo \"G1: CLEAN\"\n"
   },
   "expect": {
