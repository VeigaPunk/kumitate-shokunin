{
 "contract": "kumitate-harm-matrix-v1",
 "cases": [
  {
   "id": "honest-held",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "tip": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "expect": {
    "exit": 0,
    "rows": [
     "g1 HELD"
    ],
    "summary": "HARM_MATRIX: CLEAN gates=1 held=1"
   }
  },
  {
   "id": "repaired",
   "gates": [
    {
     "id": "g1",
     "argv": [
      "bash",
      "scripts/g1.sh"
     ],
     "verdict": "^G1: (\\w+)",
     "clean": [
      "CLEAN"
     ],
     "timeout": 5
    }
   ],
   "base": {
    "scripts/g1.sh": "echo 'G1: DRIFT'; exit 1\n"
   },
   "tip": {
    "scripts/g1.sh": "echo 'G1: CLEAN'\n"
   },
   "expect": {
    "exit": 0,
    "rows": [
     "g1 REPAIRED"
    ],
    "summary": "repaired=1"
   }
  },
