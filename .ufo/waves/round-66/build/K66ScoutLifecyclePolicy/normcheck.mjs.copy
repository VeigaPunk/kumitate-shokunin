import { readFileSync } from 'node:fs';
const CAP = '/home/vgpnk/Projects/shokunin/kumitate-shokunin/.ufo/waves/round-66/build/K66ScoutLifecyclePolicy/feature-lifecycle.md';
// norm() copied verbatim from the frozen counter deprec66-probe.mjs:52-60
const norm = (s) => s.toString('utf8')
  .replace(/<script[\s\S]*?<\/script>|<style[\s\S]*?<\/style>/gi, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/&nbsp;|&#160;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
  .replace(/&quot;|&#34;/g, '"').replace(/&#39;|&#x27;|&apos;/g, "'")
  .replace(/[\u2018\u2019]/g, "'").replace(/[\u201c\u201d]/g, '"').replace(/[\u2013\u2014]/g, '-')
  .replace(/\*\*|__|`/g, '')
  .replace(/\s+/g, ' ').trim();
const cap = norm(readFileSync(CAP));
const quotes = [
  ['Q1 L10-12', 'It defines three feature states (Active, Deprecated, Removed), the criteria and procedure for moving between them, a minimum window between deprecation and removal'],
  ['Q2 L68-70', 'the number of months, at least twelve, that the feature must remain Deprecated before it is eligible for removal.'],
  ['Q3 L70-72', 'The window is measured from the release of the specification revision in which the feature is first marked Deprecated, not from the date'],
  ['Q4 L72-73', 'The feature becomes eligible for removal in the first specification revision released as Current on or after the window elapses'],
  ['Q5 L124-125', 'Once a feature is set for removal, the removal is executed at the discretion of the Core Maintainers after the minimum deprecation window has elapsed.'],
  ['Q6 L131', 'Features may remain Deprecated, without removal, for much longer than the minimum deprecation window.'],
  ['Q7 L32', 'Existing implementations should migrate before the earliest removal date.'],
];
for (const [tag, q] of quotes) {
  const w = q.trim().split(/\s+/).length;
  console.log(`${tag} | words=${w} | norm-in-capture=${cap.includes(norm(q))}`);
}
